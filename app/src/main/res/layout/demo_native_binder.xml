<?xml version="1.0" encoding="utf-8"?><!--
  Custom native template #3 — arbitrary IDs (demo_*), bound by a caller-supplied binder.
  The library can't guess these IDs, so CustomNativeActivity passes a binder to setCustomTemplate
  that maps each asset and calls registerNativeAd itself. Root is still a NativeAdView.
-->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/demo_card_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
            android:id="@+id/demo_media"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/demo_media_bg"
            android:clipToOutline="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/demo_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="#111827"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/demo_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/demo_action"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:background="@drawable/demo_cta_gradient"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="120dp"
                android:paddingHorizontal="18dp"
                android:text="Learn more"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
