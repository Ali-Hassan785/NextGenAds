<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customNativeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ng_ink"
    android:orientation="vertical"
    tools:context=".CustomNativeActivity">

    <!-- ===================== Header ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Custom native templates"
            android:textColor="@color/ng_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCustomStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Professional layouts, each with an auto-generated shimmer."
            android:textColor="@color/ng_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ng_line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Slot 1 — professional "showcase". Custom layout from XML; NO custom shimmer, so one
                 is auto-generated from the layout. -->
            <TextView
                style="@style/Text.NextGen.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="1 · Showcase — pro template, auto shimmer" />

            <com.alihassan.nextgenads.nativead.NativeTemplateView
                android:id="@+id/customNativeShowcase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:ngad_customLayout="@layout/demo_native_showcase" />

            <!-- Slot 2 — professional "feed" row. XML custom layout, auto shimmer. -->
            <TextView
                style="@style/Text.NextGen.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="2 · Feed row — pro template, auto shimmer" />

            <com.alihassan.nextgenads.nativead.NativeTemplateView
                android:id="@+id/customNativeFeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:ngad_customLayout="@layout/demo_native_custom" />

            <!-- Slot 3 — gradient card with a HAND-DESIGNED shimmer, to show that's still supported. -->
            <TextView
                style="@style/Text.NextGen.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="3 · Gradient card — hand-made shimmer (XML)" />

            <com.alihassan.nextgenads.nativead.NativeTemplateView
                android:id="@+id/customNativeXml"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:ngad_customLayout="@layout/demo_native_gradient"
                app:ngad_customShimmer="@layout/demo_shimmer_native" />

            <!-- Slot 4 — compact row set in code; auto shimmer (no shimmer XML needed). -->
            <TextView
                style="@style/Text.NextGen.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="4 · Compact row — set in code, auto shimmer" />

            <com.alihassan.nextgenads.nativead.NativeTemplateView
                android:id="@+id/customNativeCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <!-- Slot 5 — arbitrary IDs bound by a custom binder; auto shimmer. -->
            <TextView
                style="@style/Text.NextGen.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="5 · Arbitrary IDs — custom binder, auto shimmer" />

            <com.alihassan.nextgenads.nativead.NativeTemplateView
                android:id="@+id/customNativeBinder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnReloadCustom"
                style="@style/Widget.NextGen.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Reload all" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
