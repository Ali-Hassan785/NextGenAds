<?xml version="1.0" encoding="utf-8"?><!-- Custom shimmer placeholder for the demo native templates (root is a ShimmerFrameLayout,
     as NativeTemplateView requires). Passed via app:ngad_customShimmer / setCustomTemplate. -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/demo_card_bg"
        android:orientation="vertical"
        android:padding="16dp">


        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/demo_shimmer_block" />

        <View
            android:layout_width="200dp"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/demo_shimmer_block" />

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/demo_shimmer_block" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
