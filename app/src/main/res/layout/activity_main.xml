<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ng_ink"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- ===================== Header ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="NextGen"
            android:textColor="@color/ng_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Status: not initialized"
            android:textColor="@color/ng_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ng_line" />

    <!-- ===================== Content ===================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/btnPremiumToggle"
                style="@style/Widget.NextGen.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Premium: OFF — tap to go ad-free" />

            <!-- ===== Banner ===== -->
            <LinearLayout
                style="@style/Widget.NextGen.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    style="@style/Text.NextGen.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Banner" />

                <Button
                    android:id="@+id/btnPreloadBanner"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preload banner" />

                <Button
                    android:id="@+id/btnShowBanner"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show preloaded banner" />

                <Button
                    android:id="@+id/btnLoadShowBanner"
                    style="@style/Widget.NextGen.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Load &amp; show banner on demand" />

                <Button
                    android:id="@+id/btnCollapsibleBottom"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Collapsible banner (bottom)" />

                <Button
                    android:id="@+id/btnCollapsibleTop"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Collapsible banner (top)" />

                <FrameLayout
                    android:id="@+id/bannerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="60dp" />
            </LinearLayout>

            <!-- ===== Native / Banner ===== -->
            <LinearLayout
                style="@style/Widget.NextGen.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/Text.NextGen.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Native / Banner" />

                <TextView
                    style="@style/Text.NextGen.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Ad type" />

                <RadioGroup
                    android:id="@+id/rgAdType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbTypeNative"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:checked="true"
                        android:text="Native" />

                    <RadioButton
                        android:id="@+id/rbTypeBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Banner" />
                </RadioGroup>

                <TextView
                    style="@style/Text.NextGen.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Template" />

                <!-- ChipGroup wraps to multiple lines, so every template is visible at once
                     (a horizontal RadioGroup pushed Hero/Feed/Spotlight off-screen). singleSelection
                     + selectionRequired gives the same one-of-N behaviour as a RadioGroup. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/rgTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="false"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rbSmall"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Small" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rbMedium"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Medium" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rbLarge"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Large" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rbBanner"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Banner" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rbMediaLeft"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Media-left" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rbCollapsible"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Collapsible" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rbHero"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hero" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rbFeed"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Feed" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/rbSpotlight"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spotlight" />
                </com.google.android.material.chip.ChipGroup>

                <Button
                    android:id="@+id/btnPreloadNative"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Preload native" />

                <Button
                    android:id="@+id/btnShowNative"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show preloaded native" />

                <Button
                    android:id="@+id/btnLoadShowNative"
                    style="@style/Widget.NextGen.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Load &amp; show native on demand" />

                <com.alihassan.nextgenads.BannerNativeView
                    android:id="@+id/nativeAdView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:ngad_ad_type="nativead"
                    app:ngad_template="medium" />

                <Button
                    android:id="@+id/btnCustomNative"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Custom native templates" />
            </LinearLayout>

            <!-- ===== Interstitial ===== -->
            <LinearLayout
                style="@style/Widget.NextGen.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/Text.NextGen.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interstitial" />

                <Button
                    android:id="@+id/btnPreloadInterstitial"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preload interstitial" />

                <Button
                    android:id="@+id/btnShowInterstitial"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show preloaded interstitial" />

                <Button
                    android:id="@+id/btnLoadShowInterstitial"
                    style="@style/Widget.NextGen.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Load &amp; show interstitial on demand" />

                <Button
                    android:id="@+id/btnCounterInterstitial"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Counter interstitial (1st, then every 4th)" />
            </LinearLayout>

            <!-- ===== Rewarded ===== -->
            <LinearLayout
                style="@style/Widget.NextGen.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/Text.NextGen.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rewarded" />

                <Button
                    android:id="@+id/btnPreloadRewarded"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preload rewarded" />

                <Button
                    android:id="@+id/btnShowRewarded"
                    style="@style/Widget.NextGen.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show rewarded (with dialog)" />
            </LinearLayout>

            <!-- ===== Rewarded interstitial ===== -->
            <LinearLayout
                style="@style/Widget.NextGen.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/Text.NextGen.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rewarded interstitial" />

                <Button
                    android:id="@+id/btnPreloadRewardedInt"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preload rewarded interstitial" />

                <Button
                    android:id="@+id/btnShowRewardedInt"
                    style="@style/Widget.NextGen.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show rewarded interstitial (with dialog)" />
            </LinearLayout>

            <!-- ===== App open ===== -->
            <LinearLayout
                style="@style/Widget.NextGen.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/Text.NextGen.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App open" />

                <TextView
                    style="@style/Text.NextGen.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Auto-shows when you background the app and return. Use the buttons to test manually." />

                <Button
                    android:id="@+id/btnPreloadAppOpen"
                    style="@style/Widget.NextGen.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preload app open" />

                <Button
                    android:id="@+id/btnShowAppOpen"
                    style="@style/Widget.NextGen.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show app open" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===================== Live stats ===================== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ng_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ng_ink"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/Text.NextGen.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live stats — tap to reset" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <TableLayout
                    android:id="@+id/statsTable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </HorizontalScrollView>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
