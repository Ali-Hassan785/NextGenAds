<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NextGenAds demo"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Status: not initialized"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 1. Consent + init -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1. Consent"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gather consent &amp; initialize" />

        <!-- 2. Banner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2. Banner"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPreloadBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preload banner" />

        <Button
            android:id="@+id/btnShowBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show preloaded banner" />

        <Button
            android:id="@+id/btnLoadShowBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load &amp; show banner on demand" />

        <FrameLayout
            android:id="@+id/bannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="60dp" />

        <!-- 3. Native / Banner (unified BannerNativeView) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Native / Banner (unified view)"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ad type:"
            android:textColor="#666666"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgAdType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbTypeNative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:checked="true"
                android:text="Native" />

            <RadioButton
                android:id="@+id/rbTypeBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Banner" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Template (used when Ad type = Native):"
            android:textColor="#666666"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/rgTemplate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Small" />

                <RadioButton
                    android:id="@+id/rbMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:checked="true"
                    android:text="Medium" />

                <RadioButton
                    android:id="@+id/rbLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Large" />

                <RadioButton
                    android:id="@+id/rbBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Banner" />

                <RadioButton
                    android:id="@+id/rbMediaLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Media-left" />

                <RadioButton
                    android:id="@+id/rbCollapsible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Collapsible" />
            </RadioGroup>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btnPreloadNative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preload native" />

        <Button
            android:id="@+id/btnShowNative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show preloaded native" />

        <Button
            android:id="@+id/btnLoadShowNative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load &amp; show native on demand" />

        <com.alihassan.nextgenads.BannerNativeView
            android:id="@+id/nativeAdView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:ngad_ad_type="nativead"
            app:ngad_template="medium" />

        <!-- 4. Interstitial -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="4. Interstitial"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPreloadInterstitial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preload interstitial" />

        <Button
            android:id="@+id/btnShowInterstitial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show preloaded interstitial" />

        <Button
            android:id="@+id/btnLoadShowInterstitial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load &amp; show interstitial on demand" />

        <Button
            android:id="@+id/btnCounterInterstitial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Counter interstitial (1st, then every 4th click)" />

        <!-- 5. Rewarded -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="5. Rewarded"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPreloadRewarded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preload rewarded" />

        <Button
            android:id="@+id/btnShowRewarded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show rewarded (with dialog)" />

        <!-- 6. Rewarded interstitial -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="6. Rewarded interstitial"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPreloadRewardedInt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preload rewarded interstitial" />

        <Button
            android:id="@+id/btnShowRewardedInt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show rewarded interstitial (with dialog)" />

        <!-- 7. App open -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="7. App open"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Auto-shows when you background the app and return (after init). Use the buttons to test manually."
            android:textColor="#666666"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPreloadAppOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preload app open" />

        <Button
            android:id="@+id/btnShowAppOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show app open" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom-pinned live stats panel (fill / show-rate report across all formats). Tap to reset. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D000000"
        android:fillViewport="true">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <TableLayout
                android:id="@+id/statsTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp" />
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>
