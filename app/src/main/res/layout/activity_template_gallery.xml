<?xml version="1.0" encoding="utf-8"?>
<!-- Gallery of every built-in NativeTemplate. The rows are built in code from NativeTemplate.entries
     (see TemplateGalleryActivity), so a template added to the library shows up here with no edit to
     this file — hence the empty templateGalleryList container. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/templateGalleryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ng_ink"
    android:orientation="vertical"
    tools:context=".TemplateGalleryActivity">

    <!-- ===================== Header ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/gallery_title"
            android:textColor="@color/ng_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGalleryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/gallery_subtitle"
            android:textColor="@color/ng_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ng_line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <!-- Filled at runtime: one section title + usage hint + NativeTemplateView per template. -->
        <LinearLayout
            android:id="@+id/templateGalleryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ng_line" />

    <!-- Pinned so it stays in reach: the list is fourteen full-size cards long. -->
    <Button
        android:id="@+id/btnReloadGallery"
        style="@style/Widget.NextGen.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/gallery_reload" />
</LinearLayout>
