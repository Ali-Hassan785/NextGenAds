<?xml version="1.0" encoding="utf-8"?>
<!--
  Professional template — "Feed content" row: square media on the left, headline + body on the
  right with an advertiser line and a pill CTA. ID-contract (ngad_* IDs); binds and auto-shimmers.
-->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/demo_card_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
            android:id="@+id/ngad_media"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/demo_media_bg"
            android:clipToOutline="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="96dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ngad_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#DB2777"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/ngad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="#0F172A"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/ngad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ngad_cta"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/demo_cta_gradient"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingHorizontal="18dp"
                android:text="Learn more"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
