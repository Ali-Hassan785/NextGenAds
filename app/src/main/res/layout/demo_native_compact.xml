<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom native template #2 — compact horizontal row, no media, outlined CTA.
  Also ID-contract: only the assets it needs (icon, headline, body, cta) carry ngad_* IDs; the
  omitted ones (media, stars, advertiser) are simply skipped by the binder.
-->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/demo_card_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ngad_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/demo_media_bg"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ngad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#111827"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/ngad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ngad_cta"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/demo_cta_outline"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="84dp"
            android:paddingHorizontal="14dp"
            android:text="Open"
            android:textAllCaps="false"
            android:textColor="#6D28D9"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
