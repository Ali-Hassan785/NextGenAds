<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SampleApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NextGen">

        <!-- AdMob app id — required by UMP (consent) and the Mobile Ads SDK to identify the
             publisher. Without it, UMP's requestConsentInfoUpdate fails and consent is never
             gathered. Must match the appId passed to NextGenAds.initialize (Google sample id). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.NextGen.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CustomNativeActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Live gallery of every built-in NativeTemplate, with the name to use for each. -->
        <activity
            android:name=".TemplateGalleryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Screen B of the cross-screen native-preload demo (warmed on MainActivity). -->
        <activity
            android:name=".PreloadedNativeActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Jetpack Compose demo screen: shows every ad format via :nextgenadscompose. -->
        <activity
            android:name=".ComposeAdsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Jetpack Compose splash: consent → init → cold=interstitial / warm=app-open → Compose ads. -->
        <activity
            android:name=".ComposeSplashActivity"
            android:exported="false"
            android:theme="@style/Theme.NextGen.Splash" />
    </application>

</manifest>