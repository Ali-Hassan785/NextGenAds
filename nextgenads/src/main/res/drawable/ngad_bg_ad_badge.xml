<?xml version="1.0" encoding="utf-8"?>
<!-- "Ad" badge backing. Colour comes from the ngad_adBadgeColor palette attribute (supplied by the
     ThemeOverlay in NgadTheme), so it follows the app theme / any app-wide override. -->
