<?xml version="1.0" encoding="utf-8"?>
<!-- Premium CTA: solid rounded fill with a touch ripple for tactile feedback. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ngad_cta_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ngad_cta" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
