<?xml version="1.0" encoding="utf-8"?>
<!-- Premium CTA: solid rounded fill with a touch ripple for tactile feedback. Colours come from the
     ngad_* palette attributes (supplied by the ThemeOverlay in NgadTheme), so they follow the app
     theme / any app-wide override. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/ngad_ctaRippleColor">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/ngad_ctaColor" />
            <corners android:radius="50dp" />
        </shape>
    </item>
</ripple>
