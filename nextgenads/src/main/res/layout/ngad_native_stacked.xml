<?xml version="1.0" encoding="utf-8"?>
<!-- STACKED — a compact card: the small "Ad" badge and the headline sit on top, then a full-width
     120dp media, then a full-width CTA pinned at the bottom. No icon or body. Uses the library's
     themeable ngad_* tokens; shimmer is auto-generated from this layout. -->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ngad_bg_card"

    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top row: small "Ad" badge on the left, then the headline. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ngad_ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ngad_bg_ad_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="@string/ngad_ad_badge_label"
                android:textColor="?attr/ngad_adBadgeTextColor"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/ngad_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.005"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Full-width 120dp media (square corners, like every template's media surface). -->
        <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
            android:id="@+id/ngad_media"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
             />

        <!-- Full-width CTA pinned at the bottom. -->
        <TextView
            android:id="@+id/ngad_cta"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/ngad_bg_cta"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="@string/ngad_cta_default"
            android:textAllCaps="false"
            android:textColor="?attr/ngad_ctaTextColor"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
