<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen interstitial "loading" interlude shown briefly before the ad opens. Attached to the
     host activity's decor view (not a Dialog) so it fills the whole screen and fades smoothly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ngad_surface"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ProgressBar
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/ngad_cta" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ngad_ad_loading"
        android:textColor="@color/ngad_body"
        android:textSize="14sp" />
</LinearLayout>
