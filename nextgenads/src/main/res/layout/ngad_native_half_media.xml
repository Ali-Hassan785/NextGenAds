<?xml version="1.0" encoding="utf-8"?>
<!-- HALF_MEDIA — the card is split ~50/50: media fills the left half (with the "Ad" badge overlaid),
     and the right half stacks headline, advertiser, rating, body and a CTA pinned to the bottom (no
     icon). Uses the library's themeable ngad_* tokens; shimmer is auto-generated from this layout. -->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ngad_bg_card"

    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left half: media (weight 1) with the "Ad" badge overlaid top-start. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_weight="1">

            <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
                android:id="@+id/ngad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:clipToOutline="true" />

            <TextView
                android:id="@+id/ngad_ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/ngad_bg_ad_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="@string/ngad_ad_badge_label"
                android:textColor="@color/ngad_ad_badge_text"
                android:textSize="10sp" />
        </FrameLayout>

        <!-- Right half: content column (weight 1) with the CTA pinned to the bottom. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ngad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.005"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/ngad_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <RatingBar
                android:id="@+id/ngad_stars"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.1" />

            <TextView
                android:id="@+id/ngad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <!-- Spacer pushes the CTA to the bottom of the column (kept as a gap in the shimmer). -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/ngad_cta"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/ngad_bg_cta"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="@string/ngad_cta_default"
                android:textAllCaps="false"
                android:textColor="@color/ngad_cta_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
