<?xml version="1.0" encoding="utf-8"?>
<!-- FEED — sponsored-post styling: icon + advertiser header with the "Ad" badge, headline, media,
     body and a CTA. Drops naturally into a content feed. Themeable ngad_* tokens; auto shimmer. -->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ngad_bg_card"
    android:elevation="1dp"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ngad_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:adjustViewBounds="true"
                android:background="@drawable/ngad_bg_media"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/ngad_advertiser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ngad_ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/ngad_bg_ad_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="@string/ngad_ad_badge_label"
                android:textColor="@color/ngad_ad_badge_text"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ngad_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.005"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
            android:id="@+id/ngad_media"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/ngad_bg_media"
            android:clipToOutline="true" />

        <TextView
            android:id="@+id/ngad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ngad_cta"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/ngad_bg_cta"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="@string/ngad_cta_default"
            android:textAllCaps="false"
            android:textColor="@color/ngad_cta_text"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
