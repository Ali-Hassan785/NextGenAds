<?xml version="1.0" encoding="utf-8"?>
<!-- Shimmer placeholder for ngad_native_fullscreen: a weighted media block that fills the height,
     then icon + headline/advertiser, rating, body lines and a CTA. Hand-tuned (not auto-generated)
     so the media fills the screen instead of collapsing under a wrap-height skeleton. -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ngad_bg_card"
    android:elevation="1dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="280dp"
            android:background="@drawable/ngad_bg_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/ngad_bg_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:background="@drawable/ngad_bg_placeholder" />

                <View
                    android:layout_width="90dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/ngad_bg_placeholder" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ngad_bg_placeholder" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/ngad_bg_placeholder" />

        <View
            android:layout_width="200dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/ngad_bg_placeholder" />

        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ngad_bg_placeholder" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
