<?xml version="1.0" encoding="utf-8"?>
<!-- ACTION_TOP — call-to-action pinned at the top, with the rest of the ad content (icon, headline,
     advertiser, rating, body and media) stacked below it. Useful where the primary action should be
     the first thing in reach (e.g. a bottom sheet opening upward, or a thumb-friendly footer slot).
     Uses the library's themeable ngad_* tokens; shimmer is auto-generated from this layout. -->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ngad_bg_card"
    android:elevation="1dp"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CTA on top: the first, most reachable element of the card. -->
        <TextView
            android:id="@+id/ngad_cta"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/ngad_bg_cta"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="@string/ngad_cta_default"
            android:textAllCaps="false"
            android:textColor="@color/ngad_cta_text"
            android:textSize="15sp" />

        <!-- Header row: icon + headline/advertiser, with the "Ad" badge kept top-aligned at the end. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ngad_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:adjustViewBounds="true"

                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ngad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.005"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/ngad_advertiser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ngad_ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/ngad_bg_ad_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="@string/ngad_ad_badge_label"
                android:textColor="@color/ngad_ad_badge_text"
                android:textSize="10sp" />
        </LinearLayout>

        <RatingBar
            android:id="@+id/ngad_stars"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:isIndicator="true"
            android:numStars="5"
            android:stepSize="0.1" />

        <TextView
            android:id="@+id/ngad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <!-- Media anchors the bottom of the card. -->
        <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
            android:id="@+id/ngad_media"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"

            android:clipToOutline="true" />
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
