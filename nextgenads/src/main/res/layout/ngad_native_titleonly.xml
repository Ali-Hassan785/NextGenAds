<?xml version="1.0" encoding="utf-8"?>
<!-- TITLE_ONLY — a title-forward card: the "Ad" badge sits on the left with the headline (title)
     beside it on top, then the media below the title, then a full-width CTA pinned at the bottom.
     No icon, body, advertiser or rating. Uses the library's themeable ngad_* tokens; shimmer is
     auto-generated from this layout. -->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ngad_bg_card"
    android:elevation="1dp"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top row: "Ad" badge on the left, then the title. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ngad_ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ngad_bg_ad_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="@string/ngad_ad_badge_label"
                android:textStyle="bold"
                android:textColor="?attr/ngad_adBadgeTextColor"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/ngad_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_marginVertical="4dp"
                android:letterSpacing="0.005"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Media below the title. -->
        <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
            android:id="@+id/ngad_media"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="4dp"

            android:clipToOutline="true" />

        <!-- Full-width CTA pinned at the bottom. -->
        <TextView
            android:id="@+id/ngad_cta"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/ngad_bg_cta"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="@string/ngad_cta_default"
            android:textAllCaps="false"
            android:textColor="?attr/ngad_ctaTextColor"
            android:textSize="15sp" />
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
