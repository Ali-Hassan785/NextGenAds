<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsible native template: a compact header with the media view on top, plus a down-arrow that
  collapses the media into a compact ad. The arrow is intentionally NOT registered as an ad asset,
  so tapping it controls the card instead of opening the ad.
-->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ngad_bg_card"

    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: badge + advertiser on the left, the collapse control on the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ngad_ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ngad_bg_ad_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="@string/ngad_ad_badge_label"
                android:textColor="?attr/ngad_adBadgeTextColor"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/ngad_advertiser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <!-- marginEnd clears the NativeAdView's top-right corner, where the SDK renders the
                 AdChoices icon — the two controls must never overlap (policy + misclicks). -->
            <ImageView
                android:id="@+id/ngad_collapse"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/ngad_bg_control"
                android:contentDescription="@string/ngad_collapse_desc"
                android:padding="4dp"
                android:src="@drawable/ngad_ic_collapse" />
        </LinearLayout>

        <!-- Media on top — this is the part the down-arrow collapses. -->
        <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
            android:id="@+id/ngad_media"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="8dp"

            android:clipToOutline="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ngad_icon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="12dp"
                android:adjustViewBounds="true"

                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ngad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.005"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/ngad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <RatingBar
                    android:id="@+id/ngad_stars"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:stepSize="0.1" />
            </LinearLayout>

            <TextView
                android:id="@+id/ngad_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/ngad_bg_cta"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"
                android:paddingLeft="18dp"
                android:paddingTop="11dp"
                android:paddingRight="18dp"
                android:paddingBottom="11dp"
                android:text="@string/ngad_cta_default"
                android:textAllCaps="false"
                android:textColor="?attr/ngad_ctaTextColor"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
