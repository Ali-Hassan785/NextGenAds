<?xml version="1.0" encoding="utf-8"?>
<!-- Shimmer placeholder for a large anchored adaptive banner (BannerAdHelper). A single full-width
     block: an adaptive AdView fills its whole rectangle, so one block reads truer than an
     icon/text/CTA skeleton. BannerAdHelper sets this view's height to the *resolved* banner height
     (AdSize.getHeightInPixels) before showing it, so the container doesn't jump when the real ad
     replaces the shimmer. The minHeight is only a fallback for when that sizing is skipped. -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="50dp"
        android:background="@drawable/ngad_bg_placeholder" />

</com.facebook.shimmer.ShimmerFrameLayout>
