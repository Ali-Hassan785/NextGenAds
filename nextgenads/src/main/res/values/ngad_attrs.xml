<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Which native template to inflate, by name (case-insensitive), e.g. "medium", "hero".
         Matched against the NativeTemplate enum names via NativeTemplate.fromName(); an unknown or
         missing value falls back to MEDIUM. -->
    <attr name="ngad_template" format="string" />

    <!-- ============================================================================================
         Ad palette — theme attributes that colour every ad template's CTA button and "Ad" badge.
         They are resolved through a ThemeOverlay applied to every ad view at inflation (see
         NgadTheme / NextGenAdsConfig.adThemeOverlay), so you re-colour ALL ads in one place:
           • swap the overlay:  NextGenAdsConfig.adThemeOverlay = R.style.MyAdOverlay
           • or override these attrs in that overlay / your app theme.
         The shipped default (ThemeOverlay.NextGenAds) points them at your Material3 tokens, so ads
         follow the host app's colours out of the box. Surfaces, body text and media backings already
         resolve from Material3 tokens directly. -->
    <attr name="ngad_ctaColor" format="color" />
    <attr name="ngad_ctaTextColor" format="color" />
    <attr name="ngad_ctaRippleColor" format="color" />
    <attr name="ngad_adBadgeColor" format="color" />
    <attr name="ngad_adBadgeTextColor" format="color" />

    <declare-styleable name="NativeTemplateView">
        <attr name="ngad_template" />
        <!-- Optional caller-supplied native layout (root must be a NativeAdView). When set, it
             overrides ngad_template. See NativeTemplateView for the recognised ngad_* asset IDs. -->
        <attr name="ngad_customLayout" format="reference" />
        <!-- Optional shimmer placeholder (root must be a ShimmerFrameLayout) for a custom layout. -->
        <attr name="ngad_customShimmer" format="reference" />
    </declare-styleable>

    <declare-styleable name="BannerNativeView">
        <!-- Banner vs native. Keep values in sync with AdType.fromAttr(). -->
        <attr name="ngad_ad_type" format="enum">
            <enum name="banner" value="0" />
            <enum name="nativead" value="1" />
        </attr>
        <attr name="ngad_template" />
        <!-- Banner size when ngad_ad_type="banner", by name (case-insensitive), e.g. "adaptive",
             "medium_rectangle", "large_banner". Matched against BannerSize.fromName(); an unknown or
             missing value falls back to ADAPTIVE (full-width adaptive). -->
        <attr name="ngad_banner_size" format="string" />
    </declare-styleable>
</resources>
