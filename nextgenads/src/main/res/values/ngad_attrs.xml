<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Which native template to inflate, by name (case-insensitive), e.g. "medium", "hero".
         Matched against the NativeTemplate enum names via NativeTemplate.fromName(); an unknown or
         missing value falls back to MEDIUM. -->
    <attr name="ngad_template" format="string" />

    <declare-styleable name="NativeTemplateView">
        <attr name="ngad_template" />
        <!-- Optional caller-supplied native layout (root must be a NativeAdView). When set, it
             overrides ngad_template. See NativeTemplateView for the recognised ngad_* asset IDs. -->
        <attr name="ngad_customLayout" format="reference" />
        <!-- Optional shimmer placeholder (root must be a ShimmerFrameLayout) for a custom layout. -->
        <attr name="ngad_customShimmer" format="reference" />
    </declare-styleable>

    <declare-styleable name="BannerNativeView">
        <!-- Banner vs native. Keep values in sync with AdType.fromAttr(). -->
        <attr name="ngad_ad_type" format="enum">
            <enum name="banner" value="0" />
            <enum name="nativead" value="1" />
        </attr>
        <attr name="ngad_template" />
    </declare-styleable>
</resources>
