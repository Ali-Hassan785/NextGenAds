<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Ad-template palette.

      Surfaces, text, strokes and placeholder fills are NOT defined here: the templates resolve them
      from the host theme's Material3 tokens (?attr/colorSurface, ?attr/colorOnSurface,
      ?attr/colorOnSurfaceVariant, ?attr/colorSurfaceVariant, ?attr/colorOutlineVariant). That makes
      every template — native cards, shimmer placeholders and the loading / welcome covers — follow
      the app's own light/dark identity, including apps that commit to a dark theme without the
      system `-night` qualifier (where a static `-night` color would never activate). Re-theme them by
      styling those Material tokens in your app theme; requires a Material3 (or MaterialComponents)
      theme on the host.

      The CTA button and "Ad" badge no longer read these @color values directly: they resolve the
      ngad_* palette attributes (see ngad_themes.xml / ngad_attrs.xml), which the DEFAULT overlay
      (ThemeOverlay.NextGenAds) maps to the host's Material3 tokens — so those follow the app too. The
      static values below are the *brand* fallback used by ThemeOverlay.NextGenAds.Brand (opt-in via
      NextGenAdsConfig.adThemeOverlay) and as the ripple default. Override any of them in your app's
      colors.xml, or override the ngad_* attrs to re-colour every ad in one place.
    -->
    <color name="ngad_cta">#FF2563EB</color>
    <color name="ngad_cta_text">#FFFFFFFF</color>
    <color name="ngad_cta_ripple">#52FFFFFF</color>
    <color name="ngad_ad_badge">#FFFFC861</color>
    <color name="ngad_ad_badge_text">#FF5A4500</color>
</resources>
